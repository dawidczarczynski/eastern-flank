  {
    "id": "launcher",
    "label": "Rocket launcher on a turntable (raise, traverse)",
    "status": "implemented",
    "description": "Pod on a turntable: raises on its actuators and traverses towards the target before a volley; the vehicle turns first when the target is outside the traverse range.",
    "params": {
      "traverse_deg": {
        "type": "angle_range",
        "allow_full": true,
        "min": -180,
        "max": 180,
        "default": "full",
        "unit": "deg",
        "help": "Traverse relative to the stowed direction: \"full\" or [min, max] (min <= 0 <= max)"
      },
      "max_elevation_deg": {
        "type": "number",
        "min": 1,
        "max": 90,
        "default": 40,
        "unit": "deg",
        "help": "Elevation used when firing"
      },
      "stowed": {
        "type": "enum",
        "values": [
          "rear",
          "front"
        ],
        "default": "rear",
        "help": "Direction the tube ends face when stowed"
      }
    },
    "pivots": [
      {
        "path": "Launcher"
      },
      {
        "path": "Launcher/Pod"
      },
      {
        "path": "Launcher/Pod/Mouth{i}",
        "min": 6
      },
      {
        "path": "Launcher/Actuator{i}",
        "min": 0,
        "with": [
          "Launcher/ActuatorRod{i}",
          "Launcher/Pod/ActuatorMount{i}"
        ]
      }
    ],
    "owns": [
      "Launcher"
    ]
  },
