{
  "permissions": {
    "allow": [
      "Bash(tools/check.sh:*)",
      "Bash(tools/test.sh:*)",
      "Bash(tools/lint.sh:*)",
      "Bash(godot --headless:*)",
      "Bash(gdformat:*)",
      "Bash(gdlint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format_gdscript.sh"
          }
        ]
      }
    ]
  }
}
